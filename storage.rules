rules_version = '2';

// Triply Storage rules — REQUIRED for tourist community post uploads
// (`community_posts/{uid}/...`) and guide trip covers (`trip_covers/{uid}/...`).
// Wire-up: add `"storage": {"rules": "storage.rules"}` to firebase.json,
// then `firebase deploy --only storage`.

service firebase.storage {
  match /b/{bucket}/o {
    // Tourist community post photos: owner writes, anyone reads (feed).
    match /community_posts/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Guide trip cover photos: owner writes, anyone reads (listings).
    match /trip_covers/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
