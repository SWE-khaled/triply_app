{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "*.log"]
    }
  ],
  "emulators": {
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 4000
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8092
    },
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    }
  }
}
